{
  "manifest_version": 3,
  "name": "MediaFetch",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "downloads", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open MediaFetch"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
